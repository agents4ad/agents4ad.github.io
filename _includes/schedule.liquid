{% if include.id %}
  {% assign schedule = page[include.id] %}
{% else %}
  {% assign schedule = page.schedule %}
{% endif %}

<p></p>

<style>
  .schedule-table-scroll {
    width: 100%;
    overflow-x: auto;
  }

  .schedule-table {
    min-width: 920px;
    border: solid 1px #d1d5db;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
  }

  .schedule-table-header,
  .schedule-table-row {
    display: grid;
    grid-template-columns: 120px 1.8fr 1.3fr;
    column-gap: 16px;
    padding: 14px 16px;
    align-items: start;
  }

  .schedule-table-header {
    background: #f8fafc;
    border-bottom: solid 1px #e5e7eb;
    font-weight: 700;
    color: #4b5563;
    text-align: left;
  }

  .schedule-table-row {
    border-bottom: solid 1px #edf2f7;
  }

  .schedule-table-row-even {
    background-color: #fafafa;
  }

  .schedule-table-row:last-child {
    border-bottom: none;
  }

  .schedule-time {
    font-weight: 700;
    color: #1f2937;
  }

  .schedule-event {
    color: #111827;
  }

  .schedule-content {
    color: #374151;
  }

  .schedule-speaker {
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 10px;
    align-items: start;
  }

  .schedule-speaker img {
    width: 50px;
    height: 50px;
    border-radius: 999px;
    object-fit: cover;
    margin-top: 2px;
  }

  .schedule-speaker-name {
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
  }

  .schedule-speaker-affiliation {
    margin-top: 2px;
    font-size: 12px;
    color: #6b7280;
    line-height: 1.3;
  }

  .schedule-second-speaker {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed #e5e7eb;
  }
</style>

<div class="schedule-table-scroll">
  <div class="schedule-table">
    <div class="schedule-table-header">
      <div>Time</div>
      <div>Event</div>
      <div>Content</div>
    </div>

    {% for f in schedule %}
    <div class="schedule-table-row {% cycle 'schedule-table-row-odd', 'schedule-table-row-even' %}">
      <div class="schedule-time">
        {% if f.time %}
          {{ f.time | markdownify | remove: "<p>" | remove: "</p>" }}
        {% else %}
          -
        {% endif %}
      </div>

      {% if f.event %}
        <div class="schedule-event">
          {{ f.event | markdownify | remove: "<p>" | remove: "</p>" }}
        </div>
      {% elsif f.image_path %}
        <div class="schedule-event">
          <div class="schedule-speaker">
            <div>
              <img src="{{ f.image_path | relative_url }}" alt="">
              {% if f.second_image_path %}
                <img style="margin-top:6px;" src="{{ f.second_image_path | relative_url }}" alt="">
              {% endif %}
            </div>
            <div>
              {% if f.person_name %}
                <div class="schedule-speaker-name">{{ f.person_name | markdownify | remove: "<p>" | remove: "</p>" }}</div>
              {% endif %}
              {% if f.person_affiliation %}
                <div class="schedule-speaker-affiliation">{{ f.person_affiliation | markdownify | remove: "<p>" | remove: "</p>" }}</div>
              {% endif %}

              {% if f.second_person_name %}
                <div class="schedule-second-speaker">
                  <div class="schedule-speaker-name">{{ f.second_person_name | markdownify | remove: "<p>" | remove: "</p>" }}</div>
                  {% if f.second_person_affiliation %}
                    <div class="schedule-speaker-affiliation">{{ f.second_person_affiliation | markdownify | remove: "<p>" | remove: "</p>" }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <div class="schedule-event">-</div>
      {% endif %}

      <div class="schedule-content">
        {% if f.content %}
          {{ f.content | markdownify | remove: "<p>" | remove: "</p>" }}
        {% else %}
          -
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>