{% assign papers = page.papers %}
{% assign has_poster_slot = false %}
{% for f in papers %}
  {% if f.poster_slot %}
    {% assign has_poster_slot = true %}
  {% endif %}
{% endfor %}

<p></p>

<style>
  .papers-table-scroll {
    width: 100%;
    overflow-x: auto;
  }

  .papers-table {
    min-width: 980px;
    border: solid 1px #d1d5db;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
  }

  .papers-table-header,
  .papers-table-row {
    display: grid;
    grid-template-columns: 3.3fr 2.4fr 1.2fr;
    column-gap: 16px;
    padding: 14px 16px;
    align-items: start;
  }

  .papers-table.with-slot .papers-table-header,
  .papers-table.with-slot .papers-table-row {
    grid-template-columns: 3.3fr 2.4fr 1fr 1.2fr;
  }

  .papers-table-header {
    background: #f8fafc;
    border-bottom: solid 1px #e5e7eb;
    font-weight: 700;
    color: #4b5563;
    text-align: left;
  }

  .papers-table-row {
    border-bottom: solid 1px #edf2f7;
  }

  .papers-table-row-even {
    background-color: #fafafa;
  }

  .papers-table-row:last-child {
    border-bottom: none;
  }

  .papers-table-title {
    font-weight: 700;
    color: #111827;
  }

  .papers-table-authors {
    font-style: italic;
    color: #374151;
  }

  .papers-table-slot {
    color: #111827;
  }

  .papers-slot-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: #eef2ff;
    color: #3730a3;
    font-weight: 700;
    font-size: 13px;
  }

  .papers-table-links a {
    display: block;
    margin-bottom: 4px;
  }
</style>

<div class="papers-table-scroll">
  <div class="papers-table {% if has_poster_slot %}with-slot{% endif %}">
    <div class="papers-table-header">
      <div>Title</div>
      <div>Authors</div>
      {% if has_poster_slot %}
      <div>Poster Slot</div>
      {% endif %}
      <div>Links</div>
    </div>

    {% for f in papers %}
    <div class="papers-table-row {% cycle 'papers-table-row-odd', 'papers-table-row-even' %}">
      <div class="papers-table-title">
        {{ f.title | markdownify | remove: "<p>" | remove: "</p>" }}
      </div>

      <div class="papers-table-authors">
        {{ f.authors | markdownify | remove: "<p>" | remove: "</p>" }}
      </div>
      
      {% if has_poster_slot %}
      <div class="papers-table-slot">
        {% if f.poster_slot %}
          <span class="papers-slot-badge">#{{ f.poster_slot }}</span>
        {% else %}
          -
        {% endif %}
      </div>
      {% endif %}

      <div class="papers-table-links">
        {% if page.poster_path %}
          {% if f.noposter == nil or f.noposter == false %}
            <a href="{{ page.poster_path }}/{{ f.number }}.pdf" download>Poster</a>
          {% endif %}
        {% endif %}

        {% if f.paper_link %}
          <a href="{{ f.paper_link }}">Paper (link)</a>
        {% endif %}

        {% if f.video %}
          <a href="{{ f.video }}">Video</a>
        {% endif %}

        {% if page.paper_path and f.number %}
          <a href="{{ page.paper_path }}/{{ f.number }}.pdf" download>Paper</a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>